# Copy to .env.local and fill in. app.py loads .env.local automatically
# when RENDER is not set (i.e. during local development).

# Local PostgreSQL 17 instance. Replace YOUR_PASSWORD.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/mauryahub
DB_SSLMODE=disable

DEBUG=True
PORT=5000

# Optional — Google sign-in. Without these, login is disabled locally
# but the rest of the site works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Comma-separated emails that get admin access after signing in.
ADMIN_EMAILS=

# Keep uploads on the local filesystem instead of Supabase Storage.
LOCAL_RESOURCE_UPLOADS=1
